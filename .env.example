APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
# "database" saca el TTS y el envio de correo fuera del cron y de la request
# web. Requiere la tabla `jobs` (php artisan migrate) y que el cron del
# scheduler este corriendo: el propio scheduler lanza el worker cada minuto.
# Con "sync" todo vuelve a correr inline, como antes.
QUEUE_CONNECTION=database
SESSION_DRIVER=file
SESSION_LIFETIME=120

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1

VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

# Game Masters now sign in with their own account; there is no shared password.
# Case por defecto de las partidas nuevas (carpeta bajo Immersion/Cases/).
IMMERSION_DEFAULT_CASE=steve-jacobs

# Cupo de partidas POR CASO. Con 4 casos puedes tener 6 partidas de cada uno.
# Cuentan TODAS, en cualquier estado: una partida terminada sigue ocupando
# cupo. Se libera eliminando una partida de ese mismo caso.
IMMERSION_MAX_GAMES_PER_CASE=6

IMMERSION_AI_SERVICE_URL=http://localhost:3001
IMMERSION_AI_PROJECT_ID=mystery-case
IMMERSION_AI_INTERNAL_API_KEY=CHANGE_ME_MYSTERY_CASE_AI_KEY

# Timeouts en segundos. El interrogatorio es corto porque un jugador esta
# mirando y prefiere una respuesta de reserva a esperar; los otros dos corren
# en la cola y pueden permitirse ser lentos antes que desperdiciar una
# generacion. Medido en produccion: el modelo llega a tardar 97s bajo carga y
# el TTS responde 503 "high demand" con reintento (82s hasta completar).
IMMERSION_AI_INTERROGATION_TIMEOUT=35
IMMERSION_AI_TTS_TIMEOUT=300
IMMERSION_AI_EPILOGUE_TIMEOUT=240

# Apaga una capacidad de IA por separado. Apagada = proveedor null: los
# sospechosos responden en personaje sin agregar nada, y los correos de voz
# salen sin grabacion. El caso sigue siendo jugable.
IMMERSION_AI_INTERROGATION=true
IMMERSION_AI_SPEECH=true

# Question budget per suspect for NEW interrogation sessions. Sessions
# already created keep the limit they were created with.
IMMERSION_MAX_QUESTIONS=5

# throttle middleware "attempts,minutes"
IMMERSION_THROTTLE_ASK=20,1

# --- Creditos de IA -------------------------------------------------------
# Todo lo que llama a un modelo de verdad se mide en creditos. Al iniciar una
# partida se CONGELA todo lo que podria llegar a gastar (preguntas + final), y
# lo que no se use vuelve al saldo al cerrar el caso.
# Apagado = el motor corre sin economia: no se reserva ni se cobra nada.
IMMERSION_CREDITS=true

# Cuanto cuesta cada cosa, POR PARTIDA — nunca por jugador: invitar a alguien
# mas no puede ser una decision de costo. El final clasico y los audios de la
# linea de tiempo son gratis, y eso es lo que mantiene el caso jugable para
# siempre cuando se acaban los creditos.
#
# El epilogo es el mas caro por lo que ENTREGA (cada jugador recibe algo escrito
# para el), no por lo que cuesta: medido contra los precios de Google, una
# confesion cuesta ~4.6x un epilogo de seis jugadores, porque el texto es
# barato y dos minutos de voz sintetizada no.
IMMERSION_COST_QUESTION=1
IMMERSION_COST_EPILOGUE=40
IMMERSION_COST_CONFESSION=25

# Adquirir un caso incluye los creditos para UNA partida completa, con el final
# que el comprador elija. La cantidad no se configura: se deriva del caso (sus
# preguntas + su final mas caro). Para steve-jacobs, 45 + 40 = 85.
IMMERSION_CREDITS_WITH_CASE=true
IMMERSION_INCLUDED_GAMES=1

# Horas sin actividad tras las cuales el scheduler devuelve la reserva de una
# partida que nadie cerro ni pauso. La partida no se toca y se puede reactivar
# desde su consola. Una semana: jugar un caso en dos fines de semana no deberia
# requerir nada. Pausar devuelve los creditos de inmediato.
IMMERSION_STALE_HOLD_HOURS=168

# Deja adquirir casos sin pagar (no hay pasarela todavia). Apagado en
# produccion por defecto; un sitio desplegado no debe regalar casos.
PLATFORM_SIMULATED_CHECKOUT=true

# Las paginas publicas salen con noindex hasta que el sitio se lance de verdad.
PLATFORM_INDEXABLE=false

# Account rate limits (config/platform.php)
PLATFORM_THROTTLE_LOGIN=5,1
PLATFORM_THROTTLE_REGISTER=5,10
PLATFORM_THROTTLE_PASSWORD_EMAIL=3,10
PLATFORM_THROTTLE_PASSWORD_RESET=5,10
